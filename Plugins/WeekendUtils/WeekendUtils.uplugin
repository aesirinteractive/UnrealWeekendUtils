	"MarketplaceURL": "",
	"SupportURL": "https://github.com/barzb/UnrealWeekendUtils",
	"CanContainContent": true,
	"IsBetaVersion": false,
	"IsExperimentalVersion": false,
	"Installed": true,
	"EnabledByDefault": false,
	"EditorCustomVirtualPath": "Odin/External",
	"TreatEditorCustomVirtualPathAsRoot": true,
	"Maintainers": [
		"Philipp Brasin",
		"Benjamin Barz"
	],
	"Modules": [
		{
			"Name": "WeekendUtils",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		},
		{
			"Name": "WeekendCheatMenu",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		},
		{
			"Name": "WeekendGameService",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		},
		{
			"Name": "WeekendSaveGame",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		},
		{
			"Name": "WeekendUtilsTests",
			"Type": "UncookedOnly",
			"LoadingPhase": "Default"
		}
	],
	"Plugins": [
		{
			"Name": "EnhancedInput",
			"Enabled": true
		},
		{
			"Name": "GameFeatures",
			"Enabled": true
		},
		{
			"Name": "GameplayAbilities",
			"Enabled": true
		},
		{
